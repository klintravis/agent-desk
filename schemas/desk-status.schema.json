{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "desk status --json",
  "description": "The desk status screen as data, plus its rendered text. Printed by `desk status --json`; not a desk file, so `desk check` does not look for it.",
  "type": "object",
  "required": ["v", "at", "decisions", "active", "claims", "sessions", "roots", "branches", "prs", "overlaps", "tokens", "user", "text"],
  "additionalProperties": false,
  "properties": {
    "v": { "const": 2 },
    "user": {
      "type": ["object", "null"],
      "required": ["file", "below", "raised"],
      "additionalProperties": false,
      "properties": {
        "file": { "type": "string" },
        "below": { "type": "array", "items": { "type": "object", "required": ["task", "model", "effort", "shared"], "additionalProperties": false, "properties": { "task": { "type": "string" }, "model": { "type": "string" }, "effort": { "type": "string" }, "shared": { "type": "object", "required": ["model", "effort"], "additionalProperties": false, "properties": { "model": { "type": "string" }, "effort": { "type": "string" } } } } } },
        "raised": { "type": "array", "items": { "type": "object", "required": ["task", "model", "effort", "replaced"], "additionalProperties": false, "properties": { "task": { "type": "string" }, "model": { "type": "string" }, "effort": { "type": "string" }, "replaced": { "type": "object", "additionalProperties": false, "properties": { "model": { "type": "string" }, "effort": { "type": "string" } } } } } }
      }
    },
    "at": { "type": "string", "minLength": 1 },
    "decisions": { "type": "array", "items": { "type": "object", "required": ["id", "title"], "properties": { "id": { "type": "string" }, "title": { "type": "string" } } } },
    "active": { "type": "array", "items": { "type": "object", "required": ["id", "title", "status"], "properties": { "id": { "type": "string" }, "title": { "type": "string" }, "summary": { "type": "string" }, "status": { "type": "string" } } } },
    "claims": { "type": "array", "items": { "type": "object", "required": ["slug", "from", "ts", "last"], "additionalProperties": false, "properties": { "slug": { "type": "string" }, "from": { "type": "string" }, "ts": { "type": "string" }, "last": { "type": ["string", "null"] } } } },
    "sessions": { "type": ["array", "null"], "items": { "type": "object", "required": ["session", "agents"], "additionalProperties": false, "properties": { "session": { "type": "string" }, "title": { "type": "string" }, "slug": { "type": "string" }, "agents": { "type": "array", "items": { "type": "object", "required": ["type", "about"], "additionalProperties": false, "properties": { "type": { "type": "string" }, "about": { "type": "string" } } } } } } },
    "roots": { "type": "array", "items": { "type": "object", "required": ["id", "kind", "path"], "additionalProperties": false, "properties": { "id": { "type": "string" }, "kind": { "type": "string" }, "path": { "type": "string" }, "gh": { "type": "string" }, "defaultBranch": { "type": "string" }, "merge": { "type": "string" }, "sha": { "type": "string" } } } },
    "branches": { "type": "array", "items": { "type": "object", "required": ["slug", "head", "ci", "verdict", "behind"], "additionalProperties": false, "properties": { "slug": { "type": "string" }, "head": { "type": "string" }, "ci": { "type": "string" }, "verdict": { "type": ["string", "null"] }, "behind": { "type": ["object", "null"], "required": ["base", "n"], "additionalProperties": false, "properties": { "base": { "type": "string" }, "n": { "type": "integer" } } }, "pr": { "type": "object", "required": ["number", "state", "url"], "additionalProperties": false, "properties": { "number": { "type": "integer" }, "state": { "type": "string" }, "url": { "type": "string" } } } } } },
    "prs": { "type": ["array", "null"], "items": { "type": "object", "required": ["slug", "number", "decision", "comments", "unresolved", "sinceHead"], "additionalProperties": false, "properties": { "slug": { "type": "string" }, "number": { "type": "integer" }, "decision": { "type": "string" }, "comments": { "type": "integer" }, "unresolved": { "type": "integer" }, "sinceHead": { "type": "integer" } } } },
    "overlaps": { "type": ["array", "null"], "items": { "type": "string" } },
    "tokens": { "type": ["object", "null"], "required": ["calls", "fresh", "cached", "out"], "additionalProperties": false, "properties": { "calls": { "type": "integer" }, "fresh": { "type": "integer" }, "cached": { "type": "integer" }, "out": { "type": "integer" } } },
    "text": { "type": "string" }
  }
}
