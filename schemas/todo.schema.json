{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "todo.jsonl line",
  "description": "One change to one todo; later lines win per field, notes accumulate. Written by `desk todo`.",
  "type": "object",
  "required": ["ts", "from", "id", "set"],
  "additionalProperties": false,
  "properties": {
    "v": { "const": 1 },
    "ts": { "type": "string", "minLength": 1 },
    "from": { "type": "string", "minLength": 1 },
    "id": { "type": "string", "pattern": "^T-\\d+$" },
    "set": {
      "type": "object",
      "description": "Known fields are typed; others are allowed (`todo add --<any> <value>`).",
      "properties": {
        "title": { "type": "string" },
        "summary": { "type": "string", "description": "About 50 characters (cut to 60); the Desk pane shows it instead of the title." },
        "status": { "enum": ["open", "active", "blocked", "done", "dropped"] },
        "area": { "type": "string", "minLength": 1 },
        "size": { "type": "string" },
        "prio": { "type": ["integer", "null"] },
        "parent": { "type": "string", "pattern": "^T-\\d+$" },
        "owner": { "type": "string" },
        "slug": { "type": "string" },
        "why": { "type": "string" },
        "options": { "type": "array", "items": { "type": "object", "required": ["label"], "properties": { "label": { "type": "string", "minLength": 1 }, "why": { "type": "string" } } } },
        "note": { "type": "string" },
        "state": { "type": "string" },
        "next": { "type": "string" },
        "change": { "type": "string" },
        "tasks": { "type": "string" },
        "model": { "type": "string" }
      }
    }
  }
}
