{
  "name": "agent-desk",
  "publisher": "klintravis",
  "displayName": "Agent Desk",
  "description": "The desk's status and owner decisions in the VS Code sidebar, without Claude. Runs the desk's own CLI.",
  "version": "0.8.0",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/klintravis/agent-desk" },
  "engines": { "vscode": "^1.90.0" },
  "categories": ["Other"],
  "main": "./extension.js",
  "activationEvents": ["workspaceContains:desk.config.json"],
  "capabilities": {
    "untrustedWorkspaces": { "supported": false, "description": "Runs the agent-desk CLI from the workspace's node_modules." },
    "virtualWorkspaces": false
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [{ "id": "agentDesk", "title": "Agent Desk", "icon": "icon.svg" }]
    },
    "views": {
      "agentDesk": [
        { "id": "agentDesk.decisions", "name": "Decisions", "when": "agentDesk.inDesk" },
        { "id": "agentDesk.work", "name": "Work", "when": "agentDesk.inDesk" },
        { "id": "agentDesk.todos", "name": "Todos", "when": "agentDesk.inDesk" }
      ]
    },
    "commands": [
      { "command": "agentDesk.refresh", "title": "Refresh", "category": "Agent Desk", "icon": "$(refresh)" },
      { "command": "agentDesk.decide", "title": "Decide", "category": "Agent Desk", "icon": "$(law)" }
    ],
    "menus": {
      "view/title": [
        { "command": "agentDesk.decide", "when": "view == agentDesk.decisions", "group": "navigation" },
        { "command": "agentDesk.refresh", "when": "view =~ /^agentDesk\\./", "group": "navigation" }
      ],
      "commandPalette": [
        { "command": "agentDesk.decide", "when": "agentDesk.inDesk" },
        { "command": "agentDesk.refresh", "when": "agentDesk.inDesk" }
      ]
    }
  }
}
